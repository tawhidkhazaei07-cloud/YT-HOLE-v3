# YT Hole configuration. Copy to .env and adjust. Real environment variables win.
# Never commit .env: it contains your secret key.

# ---- basics ---------------------------------------------------------------
YTHOLE_ENV=development            # development | production
YTHOLE_HOST=0.0.0.0               # 0.0.0.0 = reachable from other devices on your Wi-Fi/LAN
                                  # 127.0.0.1 = only this computer (use this behind Nginx/Caddy/tunnel)
YTHOLE_PORT=5000

# Public HTTPS address of this deployment, exactly as users type it.
# Leave empty until you really have one (domain + HTTPS proxy, or tunnel).
# It is shown in the startup banner, allowed for CORS, and used in reset e-mails.
# YTHOLE_PUBLIC_URL=https://ythole.example.com

# Required in production (32+ random characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# In development a key is generated into data/.secret_key automatically.
# YTHOLE_SECRET_KEY=

# ---- reverse proxy / HTTPS ---------------------------------------------------
YTHOLE_TRUST_PROXY=false          # true ONLY when a reverse proxy/tunnel sits in front
YTHOLE_PROXY_HOPS=1               # number of proxies in front (Cloudflare + Nginx = 2)
YTHOLE_COOKIE_SECURE=auto         # auto = on when YTHOLE_PUBLIC_URL is https
YTHOLE_COOKIE_SAMESITE=Lax        # None only if the frontend is on a different site (needs HTTPS)

# ---- frontend hosted separately? -------------------------------------------
YTHOLE_SERVE_FRONTEND=true        # false when Nginx/Caddy/CDN serves frontend/
# Comma-separated origins of separately hosted frontends (never "*"):
# YTHOLE_ALLOWED_ORIGINS=https://www.example.com,https://app.example.com

# ---- downloader ----------------------------------------------------------------
YTHOLE_ENGINE=auto                # auto/ytdlp = yt-dlp; simulated = offline test engine (refused in production)
# YTHOLE_FFMPEG=/usr/bin/ffmpeg   # auto-detected from PATH if empty
YTHOLE_MAX_CONCURRENT=3           # downloads running at the same time (whole server)
YTHOLE_MAX_JOBS_PER_USER=2
YTHOLE_DAILY_DOWNLOAD_LIMIT=10
YTHOLE_MAX_DURATION=14400         # seconds
YTHOLE_MAX_FILESIZE_MB=4096
YTHOLE_USER_QUOTA_MB=10240
YTHOLE_GUEST_QUOTA_MB=2048
YTHOLE_FILE_RETENTION_HOURS=24    # finished files of logged-in users are kept this long
YTHOLE_GUEST_RETENTION_MINUTES=60
# YTHOLE_ACCEL_REDIRECT=/_ythole_files   # let Nginx stream files (see deployment/nginx)

# ---- accounts ------------------------------------------------------------------
YTHOLE_REGISTRATION_OPEN=true
YTHOLE_REQUIRE_LOGIN=false        # true = only logged-in users can analyze/download
YTHOLE_SESSION_DAYS=30            # "remember me" duration

# ---- limits (per client IP, per minute) -----------------------------------------
YTHOLE_RATE_LIMIT_GLOBAL=240
YTHOLE_RATE_LIMIT_AUTH=10
YTHOLE_RATE_LIMIT_ANALYZE=20
YTHOLE_RATE_LIMIT_DOWNLOAD=10

# ---- server ------------------------------------------------------------------
YTHOLE_THREADS=16
YTHOLE_LOG_LEVEL=INFO
# YTHOLE_DATA_DIR=./data
# YTHOLE_LOG_DIR=./logs

# ---- password reset e-mail (optional; needs YTHOLE_PUBLIC_URL) ------------------
# YTHOLE_SMTP_HOST=smtp.example.com
# YTHOLE_SMTP_PORT=587
# YTHOLE_SMTP_USER=
# YTHOLE_SMTP_PASSWORD=
# YTHOLE_SMTP_FROM=YT Hole <no-reply@example.com>
